# The settings npm run dev, npm run launch and Terraform read. Copy this file to .env and fill it in; .env stays out of git.
# No Stellar secret key goes here, or anywhere else in this project.

# The account clients pay, in USDC: a public G... address in your own wallet. Leave it empty: npm run launch:oci sets
# one up. Mainnet has no throwaway accounts.
PAY_TO=
# Where clients reach this service on this computer. On the server, Terraform sets the public https:// one.
PUBLIC_ORIGIN=http://localhost:8787
# The job database: paid jobs live here, so keep it on a disk that survives restarts.
JOB_DB_PATH=./jobs.sqlite
# Your Stellar 8004 agent id: npm run launch:oci saves it.
AGENT_ID=

# Mainnet's facilitator settles payments with an API key: get one at https://channels.openzeppelin.com/gen, and write it
# here as "Bearer <key>". Terraform sends it to the server.
FACILITATOR_AUTH=
# A Soroban RPC, to decide uncertain payments from the chain: mainnet has no default. This is the one the Stellar
# 8004 SDK uses; for production traffic, a provider's is safer: https://developers.stellar.org/docs/data/apis/rpc/providers
SOROBAN_RPC_URL=https://mainnet.sorobanrpc.com

# The narration API (app.py). Defaults suit most machines.
# kokoro (default) or fake: a tone instead of speech, to try the payment flow without the model. Never sell fake.
# TTS_ENGINE=kokoro
# kokoro-v1.0.onnx (default, full precision) or kokoro-v1.0.int8.onnx (88 MB): scripts/download-models.sh fetches either.
# KOKORO_MODEL=kokoro-v1.0.onnx
# Text chunks read in parallel: default, one per CPU core.
# TTS_WORKERS=
# How long audio files are kept, in seconds: at least the jobs' 24 hours [S8].
# AUDIO_RETENTION_SECONDS=90000
