      "maxInputBytes": 8192,
      "capacity": {
        "concurrency": 2,
        "maxQueued": 20,
        "maxQueueWaitSeconds": 30
      },
      "upstream": {
        "url": "http://127.0.0.1:8000/tts/narrate-short"
      }
    },
