# Copy to terraform.tfvars (kept out of git) and fill in. Your API key stays in ~/.oci/config.

tenancy_ocid = "ocid1.tenancy.oc1..aaaaaaaa..."
region       = "eu-frankfurt-1" # your home region: Always Free is only free there

# oci_profile       = "DEFAULT"
# compartment_ocid  = ""              # empty: the root compartment

# ssh_public_key_path  = "~/.ssh/id_ed25519.pub"
# ssh_private_key_path = "~/.ssh/id_ed25519"
# ssh_allowed_cidr     = "203.0.113.7/32" # your own address; default anywhere

# domain = "narration.example.com"   # with an A record to the server's IP; empty: <ip>.sslip.io

# Always Free: 2 OCPUs and 12 GB in total. A Pay As You Go account can go higher (billed above the free amount).
# ocpus     = 2
# memory_gb = 12

# availability_domain_index = 0      # try 1 or 2 on "Out of host capacity"
# assign_reserved_ip        = false  # true: an address that outlives the server, if your limits allow one
# kokoro_model              = "kokoro-v1.0.onnx"
